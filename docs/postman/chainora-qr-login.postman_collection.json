{
  "info": {
    "_postman_id": "4f4e87f9-79d7-4ef4-b32e-2f0f0e5ab451",
    "name": "Chainora QR Login",
    "description": "Collection test QR Login flow: healthz -> create session -> verify signature.\n\nNotes:\n- Run Create Session first to auto-populate sessionId/nonce/wsUrl.\n- For WebSocket, open a WS request manually and use {{wsUrl}}.\n- Set signature/address/v variables before Verify.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/healthz",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "healthz"
          ]
        },
        "description": "Check backend is alive before running auth flow."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('healthz returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const data = pm.response.json();",
              "pm.test('healthz ok=true', function () {",
              "  pm.expect(data.ok).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Session (QR)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/auth/session",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "auth",
            "session"
          ]
        },
        "description": "Create QR login session and auto-save sessionId/nonce/wsUrl."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('session created', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const data = pm.response.json();",
              "pm.test('has sessionId and nonce', function () {",
              "  pm.expect(data.sessionId).to.be.a('string').and.not.empty;",
              "  pm.expect(data.nonce).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.environment.set('sessionId', data.sessionId);",
              "pm.collectionVariables.set('sessionId', data.sessionId);",
              "pm.environment.set('nonce', data.nonce);",
              "pm.collectionVariables.set('nonce', data.nonce);",
              "",
              "const resolvedBase = pm.environment.get('baseUrl') || pm.collectionVariables.get('baseUrl') || 'http://localhost:8080';",
              "const wsBase = resolvedBase.replace(/^http/i, 'ws');",
              "pm.environment.set('wsUrl', `${wsBase}/v1/auth/ws/${data.sessionId}`);",
              "pm.collectionVariables.set('wsUrl', `${wsBase}/v1/auth/ws/${data.sessionId}`);",
              "",
              "console.log('sessionId =', data.sessionId);",
              "console.log('nonce =', data.nonce);",
              "console.log('wsUrl =', pm.environment.get('wsUrl'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify Signature",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"address\": \"{{address}}\",\n  \"signature\": \"{{signature}}\",\n  \"v\": {{v}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/auth/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "auth",
            "verify"
          ]
        },
        "description": "Send signature from mobile flow. Body is auto-built in Pre-request Script."
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const sessionId = pm.environment.get('sessionId') || pm.collectionVariables.get('sessionId');",
              "const address = pm.environment.get('address') || pm.collectionVariables.get('address') || '0x0000000000000000000000000000000000000000';",
              "const signature = pm.environment.get('signature') || pm.collectionVariables.get('signature') || '0xYOUR_SIGNATURE_HEX';",
              "const v = Number(pm.environment.get('v') || pm.collectionVariables.get('v') || 1);",
              "",
              "if (!sessionId) {",
              "  throw new Error('Missing sessionId. Run Create Session (QR) first.');",
              "}",
              "",
              "const body = { sessionId, address, signature, v };",
              "pm.request.body.update(JSON.stringify(body, null, 2));",
              "console.log('verify body =', body);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('verify returns success or expected auth error', function () {",
              "  pm.expect([200, 400, 401, 404, 410]).to.include(pm.response.code);",
              "});",
              "",
              "let data = {};",
              "try { data = pm.response.json(); } catch (e) {}",
              "",
              "if (pm.response.code === 200) {",
              "  pm.test('verified true and token exists', function () {",
              "    pm.expect(data.verified).to.eql(true);",
              "    pm.expect(data.token).to.be.a('string');",
              "  });",
              "  if (data.token) pm.environment.set('jwtToken', data.token);",
              "  if (data.token) pm.collectionVariables.set('jwtToken', data.token);",
              "} else {",
              "  console.log('verify failed as expected for invalid signature:', pm.response.code, data);",
              "}"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "address",
      "value": "0x0000000000000000000000000000000000000000"
    },
    {
      "key": "signature",
      "value": "0xYOUR_SIGNATURE_HEX"
    },
    {
      "key": "v",
      "value": "1"
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "nonce",
      "value": ""
    },
    {
      "key": "wsUrl",
      "value": ""
    },
    {
      "key": "jwtToken",
      "value": ""
    }
  ]
}
