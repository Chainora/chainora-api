server:
  port: "8090"

initia:
  api_url: "https://api.testnet.initia.xyz"

chainora:
  # Used by invite/funding notification jobs to scan pool contract logs.
  # Can be overridden by CHAINORA_RPC_URL environment variable.
  rpc_url: ""

scheduler:
  scan_interval_seconds: 60
  request_timeout_seconds: 6

database:
  # Prefer leaving blank and provide DB_URL/DATABASE_URL from secret env.
  url: ""

username_sync:
  # Optional static list; can also use USERNAME_SYNC_ADDRESSES env.
  addresses: []
