# Secret environment for local backend and migrations
# 1) Copy this file to src/migration/config/.env
# 2) Fill values for your environment
# 3) Never commit real secrets

# -----------------------------------------------------------------------------
# Database / Migration
# Use a Supabase direct Postgres connection string with SSL.
# The app loader accepts DATABASE_URL or DB_URL; use DATABASE_URL as the default.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
MIGRATIONS_DIR=migrations

# -----------------------------------------------------------------------------
# Required app secrets
# -----------------------------------------------------------------------------
JWT_SECRET=__TODO_CHANGE_ME__
CHAINORA_RPC_URL=http://157.66.100.120:8545/

# -----------------------------------------------------------------------------
# Worker
# Comma-separated EVM addresses for username sync, or leave blank.
# -----------------------------------------------------------------------------
USERNAME_SYNC_ADDRESSES=

# -----------------------------------------------------------------------------
# Username relayer
# -----------------------------------------------------------------------------
RELAYER_MASTER_PRIVATE_KEY=
RELAYER_MASTER_ADDRESS=
RELAYER_INITIAD_BINARY=initiad
RELAYER_CHAIN_ID=initiation-2
RELAYER_NODE_URL=https://rpc.testnet.initia.xyz:443
RELAYER_KEY_NAME=master
RELAYER_KEYRING_BACKEND=os
RELAYER_HOME=
RELAYER_GAS_PRICES=

# Required for rollup relayer execution when dry-run is disabled.
RELAYER_MOVE_MODULE_ADDR=
RELAYER_MOVE_MODULE_NAME=
RELAYER_MOVE_FUNCTION_NAME=
RELAYER_MOVE_ARGS_JSON=["string:{username}","u64:31536000"]
RELAYER_MOVE_TYPE_ARGS_JSON=[]
RELAYER_DRY_RUN=true

# -----------------------------------------------------------------------------
# Card verification / reputation sync
# -----------------------------------------------------------------------------
CARD_DEVICE_VERIFIER_PRIVATE_KEY=
REPUTATION_VERIFIER_PRIVATE_KEY=
REPUTATION_TX_SENDER_PRIVATE_KEY=
REPUTATION_SYNC_DEADLINE_SECONDS=600
REPUTATION_SYNC_RETRY_MAX=2
REPUTATION_SYNC_COOLDOWN_SECONDS=15
REPUTATION_SYNC_BATCH_SIZE=100

# -----------------------------------------------------------------------------
# Cloudinary media upload support (optional)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
