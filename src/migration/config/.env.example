# Single environment config for backend + migration
# 1) Copy this file to src/migration/config/.env
# 2) Fill values for your environment
# 3) Never commit real secrets

# -----------------------------------------------------------------------------
# Database / Migration
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>?sslmode=require
MIGRATIONS_DIR=migrations

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
PORT=8080
APP_ENV=production

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
JWT_SECRET=<strong-secret>
JWT_ISSUER=chainora-api
JWT_TTL_MINUTES=15
JWT_REFRESH_TTL_MINUTES=10080
AUTH_MESSAGE_TEMPLATE=Sign this to login to Chainora: %s

# -----------------------------------------------------------------------------
# Chainora Rollup / RPC
# -----------------------------------------------------------------------------
INITIA_RPC_URL=http://<rollup-rpc-host>:8545
INITIA_API_URL=https://api.testnet.initia.xyz

# -----------------------------------------------------------------------------
# Worker (optional)
# -----------------------------------------------------------------------------
WORKER_PORT=8090
WORKER_SCAN_INTERVAL_SECONDS=60
WORKER_REQUEST_TIMEOUT_SECONDS=6
WORKER_USERNAME_SYNC_ADDRESSES=

# -----------------------------------------------------------------------------
# Username Relayer
# Security note: store real private key in secret manager for prod.
# This example uses placeholders only.
# -----------------------------------------------------------------------------
RELAYER_MASTER_PRIVATE_KEY=<hex-private-key-without-0x>
RELAYER_MASTER_ADDRESS=<bech32-or-evm-master-address>
RELAYER_MESSAGE_TEMPLATE=Register Chainora username '%s' (session: %s)

RELAYER_INITIAD_BINARY=initiad
RELAYER_CHAIN_ID=<chainora-rollup-chain-id>
RELAYER_NODE_URL=http://<rollup-rpc-host>:26657
RELAYER_KEY_NAME=master
RELAYER_KEYRING_BACKEND=os
RELAYER_HOME=
RELAYER_GAS_PRICES=<example:0.03tcnr>

# Required for rollup relayer execution (current backend uses `initiad tx move execute`).
RELAYER_MOVE_MODULE_ADDR=<ROLLUP_USERNAMES_MODULE_ADDR>
RELAYER_MOVE_MODULE_NAME=<ROLLUP_USERNAMES_MODULE_NAME>
RELAYER_MOVE_FUNCTION_NAME=<ROLLUP_REGISTER_FUNCTION>
RELAYER_MOVE_ARGS_JSON=["string:{username}","u64:31536000"]
RELAYER_MOVE_TYPE_ARGS_JSON=[]

RELAYER_DRY_RUN=true

# -----------------------------------------------------------------------------
# Card Verification (INS 0x23 / 0x24)
# Factory root public key (uncompressed secp256k1, hex with 04 prefix)
# -----------------------------------------------------------------------------
CARD_FACTORY_ROOT_PUBLIC_KEY=043e5662949af3d3bdf8c226bdd8444098a14f8960870ccb5be55bbe098b363aadd06109c1c50cfcfb44f80ecd082fd1d00fc8de8c73ed521ad0bab962422f721a