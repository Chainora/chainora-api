# Production environment template
# Copy to product.env and fill Railway production database values.

DATABASE_URL=postgres://<prod_user>:<prod_password>@<prod_host>:<prod_port>/<prod_db>?sslmode=require
MIGRATIONS_DIR=migrations

# Backend runtime envs (optional in this file, useful for manual run)
PORT=8080
JWT_SECRET=<production_strong_secret>
JWT_ISSUER=chainora-api-production
JWT_TTL_MINUTES=15
JWT_REFRESH_TTL_MINUTES=10080
APP_ENV=production
