# Staging environment template
# Copy to staging.env and fill Railway staging database values.

DATABASE_URL=postgres://<staging_user>:<staging_password>@<staging_host>:<staging_port>/<staging_db>?sslmode=require
MIGRATIONS_DIR=migrations

# Backend runtime envs (optional in this file, useful for local run)
PORT=8080
JWT_SECRET=<staging_strong_secret>
JWT_ISSUER=chainora-api-staging
JWT_TTL_MINUTES=15
JWT_REFRESH_TTL_MINUTES=10080
APP_ENV=staging
